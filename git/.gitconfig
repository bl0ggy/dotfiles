[alias]
	fa = fetch --all --prune
    ignore = "!f() { echo \"$1\" >> .gitignore; git add .gitignore; cat .gitignore | sort -u -o .gitignore; }; f"
[init]
	defaultBranch = main
[merge]
	ff = false
	tool = meld
[pull]
	ff = true
[core]
	editor = nvim
[rebase]
	updateRefs = false
	abbreviateCommands = true
